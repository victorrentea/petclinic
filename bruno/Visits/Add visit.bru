meta {
  name: Add visit
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/visits
  body: json
  auth: inherit
}

body:json {
  {
    "date": "2026-12-01",
    "description": "rabies shot",
    "petId": {{petId}}
  }
}

script:post-response {
  const loc = res.getHeader('location');
  if (loc) bru.setVar('visitId', loc.split('/').pop());
}
