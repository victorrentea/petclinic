@startuml

title Backend Logical Architecture (java packages)
caption All boxes and lines are ArchUnit-tested vs code
footer petclinic-backend/docs/packages.puml

skinparam shadowing false
skinparam componentStyle rectangle
skinparam nodesep 20
' the box label is the package pattern itself, which ArchUnit reads from the stereotype;
' the stereotype is hidden so the pattern is not printed twice
hide stereotype
skinparam ranksep 30
<style>
component {
  BackGroundColor #ECEFF1
  LineColor #546E7A
}
arrow {
  LineColor #78909C
}
</style>

[..rest] <<..rest>>
[..mcp] <<..mcp>>
[..rest.error] <<..rest.error>>
[..security] <<..security>>
[..mapper] <<..mapper>>
[..repository] <<..repository>>
[..notification] <<..notification>>
[..rest.dto] <<..rest.dto>>
[..domain] <<..domain>>

[..repository] --> [..domain]
[..mapper] --> [..domain]
[..mapper] --> [..rest.dto]
[..rest] --> [..domain]
[..rest] --> [..repository]
[..rest] --> [..mapper]
[..rest] --> [..rest.dto]
[..rest] --> [..notification]
[..mcp] --> [..domain]
[..mcp] --> [..repository]

@enduml
