@startuml

title Logical Architecture
caption All lines are ArchUnit-tested vs code by PackagesArchTest
footer petclinic-backend/docs/packages.puml

' ── The recipe (portable — copy this trick to any project) ───────────────────
' CYCLES ARE RED. A bidirectional dependency is ONE red double-headed line.
' ArchUnit cannot parse `<-->` arrows, so back each red line with two
' `-[hidden]->` arrows, which it *does* parse as the two directed edges:
'     [A] <-[#red,thickness=2]-> [B]
'     [A] -[hidden]-> [B]
'     [B] -[hidden]-> [A]
' No cycle exists here today; the convention is in place so one shows up red.
' ─────────────────────────────────────────────────────────────────────────────

skinparam shadowing false
skinparam componentStyle rectangle
skinparam nodesep 20
skinparam ranksep 30
<style>
component {
  BackGroundColor #ECEFF1
  LineColor #546E7A
  FontStyle bold
}
arrow {
  LineColor #78909C
}
</style>

[REST] <<..rest>>
[MCP] <<..mcp>>
[REST Error] <<..rest.error>>
[Security] <<..security>>
[Mapper] <<..mapper>>
[Repository] <<..repository>>
[DTO] <<..rest.dto>>
[Domain] <<..domain>>

[Repository] --> [Domain]
[Mapper] --> [Domain]
[Mapper] --> [DTO]
[REST] --> [Domain]
[REST] --> [Repository]
[REST] --> [Mapper]
[REST] --> [DTO]
[MCP] --> [Domain]
[MCP] --> [Repository]

@enduml
