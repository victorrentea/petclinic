# Copy to ~/.claude/jenkins.env (chmod 600) - outside every repo, so the same
# token works for all your projects and can never be committed by accident.
# Lookup order, first file wins:
#   $JENKINS_ENV_FILE  ->  ./.jenkins.env  ->  ~/.claude/jenkins.env  ->  ~/.jenkins.env
# Real environment variables always win over the file.

JENKINS_URL=https://jenkins.your-company.com

# Jenkins' own variable names, so the same file also feeds jenkins-cli.jar.
# Token: your avatar -> Security -> API Token -> Add new token.
# Never your password: an API token is revocable and scoped to your account.
JENKINS_USER_ID=victor
JENKINS_API_TOKEN=paste-the-32-hex-token-here

# Alternative to the two above, mirroring the jar's -auth flag:
#JENKINS_AUTH=victor:paste-the-32-hex-token-here
#JENKINS_AUTH=@/Users/victor/.jenkins-auth     # 'user:token' read from a file

# Corporate Jenkins behind a self-signed certificate (same as --insecure):
#JENKINS_INSECURE=1
