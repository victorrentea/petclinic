# Copy to ~/.claude/confluence.env and chmod 600. That location is deliberate: it
# is outside every repo, so one PAT serves every project you work on, and it can
# never be committed by accident.
#
#   install -m 600 /dev/null ~/.claude/confluence.env
#   $EDITOR ~/.claude/confluence.env
#
# confluence.sh reads the FIRST file that exists, in this order:
#   $CONFLUENCE_ENV_FILE -> ./.confluence.env -> ~/.claude/confluence.env -> ~/.confluence.env
# so a project can override the shared token by dropping a ./.confluence.env next to it.

# --- required -----------------------------------------------------------------

# Data Center / Server: the context root, e.g. https://confluence.your-company.com
# Cloud: the site root, e.g. https://your-site.atlassian.net  (the /wiki suffix is
# added for you; supplying it yourself also works)
CONFLUENCE_URL=https://confluence.your-company.com

# Confluence Data Center / Server: a Personal Access Token, sent as `Authorization: Bearer`.
# Mint one at: avatar -> Settings -> Personal Access Tokens -> Create token
CONFLUENCE_PAT=

# Confluence Cloud instead? Comment out CONFLUENCE_PAT and use these two (HTTP Basic).
# The SAME token works for Jira Cloud on the same site, so one credential covers
# both this skill and jira-cli.
# Token from https://id.atlassian.com/manage-profile/security/api-tokens
#CONFLUENCE_USER=you@company.com
#CONFLUENCE_API_TOKEN=

# --- optional -----------------------------------------------------------------

# Lets you run `confluence.sh create -t "..."` without repeating --space every time.
#CONFLUENCE_DEFAULT_SPACE=DOCS

# Which REST API carries page CRUD. Defaults to v1 on DC (the only one there) and
# v2 on Cloud (v1 content endpoints are being withdrawn). Set to v1 on Cloud only
# if you hit a v2 gap. CQL search, label writes and attachment uploads always use
# v1, because v2 has no equivalent.
#CONFLUENCE_PAGE_API=v2

# Forced only if auto-detection guesses wrong: 'server' (DC/Server) or 'cloud'.
# It decides the /wiki path prefix and whether v2 exists at all.
#CONFLUENCE_FLAVOR=server

# Set to 0 for an internal instance with a self-signed certificate (adds curl -k).
#CONFLUENCE_SSL_VERIFY=1
