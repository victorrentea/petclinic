# Copy to ~/.claude/jira.env and chmod 600. That location is deliberate: it is
# outside every repo, so one PAT serves every project you work on, and it can
# never be committed by accident.
#
#   install -m 600 /dev/null ~/.claude/jira.env
#   $EDITOR ~/.claude/jira.env
#
# jira.sh reads the FIRST file that exists, in this order:
#   $JIRA_ENV_FILE  ->  ./.jira.env  ->  ~/.claude/jira.env  ->  ~/.jira.env
# so a project can override the shared token by dropping a ./.jira.env next to it.

# --- required -----------------------------------------------------------------

JIRA_URL=https://jira.your-company.com

# JIRA Server / Data Center: a Personal Access Token, sent as `Authorization: Bearer`.
# Mint one at: avatar -> Profile -> Personal Access Tokens -> Create token
JIRA_PAT=

# JIRA Cloud instead? Comment out JIRA_PAT and use these two (HTTP Basic).
# Token from https://id.atlassian.com/manage-profile/security/api-tokens
#JIRA_USER=you@company.com
#JIRA_API_TOKEN=

# --- optional -----------------------------------------------------------------

# Lets you run `jira.sh create -s "..."` without repeating --project every time.
#JIRA_DEFAULT_PROJECT=PET

# REST API version. 2 is right for Server/DC, and also works on Cloud with
# plain-text descriptions. Only set 3 if you want Cloud's ADF document format.
#JIRA_API_VERSION=2

# Set to 0 for an internal instance with a self-signed certificate (adds curl -k).
#JIRA_SSL_VERIFY=1

# Forced only if auto-detection guesses wrong: it decides whether users are
# addressed by `name` (server) or `accountId` (cloud).
#JIRA_DEPLOYMENT=server
