#!/usr/bin/env bash
set -e

# Git exports GIT_DIR (absolute, the worktree's gitdir) into hooks. Any git call a
# sub-script makes from a subdir then infers that subdir as the work-tree, so
# `rev-parse --show-toplevel` returns the subdir instead of the repo root — breaking
# this hook in any git worktree. Drop the inherited git env so every git call
# auto-discovers the real work-tree (normal AND worktrees). Same reason as pre-push.
unset GIT_DIR GIT_WORK_TREE

ROOT="$(git rev-parse --show-toplevel)"

# ── Secrets scan (gitleaks) ────────────────────────────────────────────────
if command -v gitleaks >/dev/null 2>&1; then
  if ! GITLEAKS_OUT=$(gitleaks protect --staged --redact --no-banner -c "$ROOT/.config/gitleaks.toml" 2>&1); then
    echo "$GITLEAKS_OUT"
    echo ""
    echo "[pre-commit] ❌ Secrets detected in staged changes — commit blocked."
    echo "[pre-commit]    Remove the secret, rotate it if it was real, then re-stage."
    exit 1
  fi
else
  echo "[pre-commit] ⚠️  gitleaks not installed — skipping secret scan."
  echo "[pre-commit]    Install with: brew install gitleaks"
fi

# ── Project-local secrets scan (catches custom-shape secrets gitleaks misses) ─
SECRETS_FILE="$ROOT/secrets.env"
if [ -f "$SECRETS_FILE" ]; then
  STAGED_ADDITIONS=$(git diff --cached -U0 --no-color -- ':!secrets.env' | grep -E '^\+[^+]' || true)
  if [ -n "$STAGED_ADDITIONS" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
      [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
      value="${value%$'\r'}"
      value="${value%"${value##*[![:space:]]}"}"
      if [[ "$value" =~ ^\"(.*)\"$ ]] || [[ "$value" =~ ^\'(.*)\'$ ]]; then
        value="${BASH_REMATCH[1]}"
      fi
      [[ ${#value} -ge 8 ]] || continue
      if printf '%s\n' "$STAGED_ADDITIONS" | grep -F -q -- "$value"; then
        echo ""
        echo "[pre-commit] ❌ Value of \$$key (from secrets.env) appears in staged additions — commit blocked."
        echo "[pre-commit]    Rotate the secret if it was real, scrub it from your changes, then re-stage."
        exit 1
      fi
    done <"$SECRETS_FILE"
  fi
fi

# ── Backend: Spotless-format staged Java files ─────────────────────────────
# (moved here from .claude/hooks/post-java-edit.sh — formatting on every edit
#  invalidated Claude's read cache)
STAGED_JAVA=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^petclinic-backend/.*\.java$' || true)
if [ -n "$STAGED_JAVA" ]; then
  if command -v mvn >/dev/null 2>&1; then
    # Scope spotless:apply to exactly the staged files. Plain `mvn spotless:apply`
    # reformats the WHOLE petclinic-backend module on every commit — on a machine
    # running several Claude sessions against the same checkout, that silently
    # rewrote another session's un-staged, in-progress edit in
    # FakeSmsNotificationSender.java (removeUnusedImports clipped an import it was
    # mid-typing) twice in one day. `spotlessFiles` (spotless-maven-plugin 2.44.0,
    # confirmed present in petclinic-backend/pom.xml) takes a comma-separated list
    # of regexes matched against each file's ABSOLUTE path, so the staged relative
    # paths are prefixed with $ROOT and dot-escaped before joining.
    # `ratchetFrom` was considered and rejected: it scopes by git history ("files
    # changed since ref X"), not by what's staged right now — a file with mixed
    # staged/unstaged hunks, or a file changed on disk but not part of this commit,
    # would still get swept in.
    #
    # Detected *before* spotless runs (after, the working tree no longer differs
    # from itself, so this could not be found post-hoc): staged files that also
    # carry unstaged edits on top. Spotless formats the working-tree file as a
    # whole, so it reformats that unstaged part too, even though only the staged
    # part is added to this commit. We warn instead of trying to stash/split it —
    # see repo policy: never stash in this shared checkout.
    UNSTAGED_TOO=$(comm -12 <(echo "$STAGED_JAVA" | sort) <(git diff --name-only | sort))

    SPOTLESS_FILES=$(echo "$STAGED_JAVA" | sed "s#^#$ROOT/#; s/[.]/\\\\./g" | paste -sd, -)
    if ! SPOTLESS_OUT=$(cd "$ROOT/petclinic-backend" && mvn spotless:apply -q "-DspotlessFiles=$SPOTLESS_FILES" 2>&1); then
      echo "$SPOTLESS_OUT"
      echo "[pre-commit] ❌ Spotless failed — commit blocked."
      exit 1
    fi
    if [ -n "$UNSTAGED_TOO" ]; then
      echo "[pre-commit] ⚠️  Spotless reformatted the whole working-tree file for the files below, including unstaged edits on top of what's staged — only the staged part is going into this commit, the unstaged part just got reformatted along with it:"
      echo "$UNSTAGED_TOO" | sed 's/^/[pre-commit]      /'
    fi
    # Re-stage the formatted files so the commit contains the formatted version.
    while IFS= read -r f; do
      git add "$ROOT/$f"
    done <<<"$STAGED_JAVA"
  else
    echo "[pre-commit] ⚠️  mvn not on PATH — skipping Spotless formatting."
  fi

  # ── ast-grep: structural rules that enforce AGENTS.md conventions ────────
  # Reports on the staged files; see the whole-tree pass below for what
  # actually blocks. Blocks on `error`; `warning` only reports.
  if command -v sg >/dev/null 2>&1 && sg scan --help >/dev/null 2>&1; then
    if ! SG_OUT=$(cd "$ROOT" && echo "$STAGED_JAVA" | xargs sg scan -c "$ROOT/.config/sgconfig.yml" 2>&1); then
      echo "$SG_OUT"
      echo "[pre-commit] ❌ ast-grep rule violated — commit blocked."
      echo "[pre-commit] Rules live in .ast-grep/rules/ — see AGENTS.md for the why."
      exit 1
    fi
    [ -n "$SG_OUT" ] && echo "$SG_OUT"
  else
    echo "[pre-commit] ⚠️  ast-grep not installed — skipping structural lint."
    echo "[pre-commit] Install with: brew install ast-grep"
  fi
fi

# ── ast-grep: whole-tree pass, ungated ─────────────────────────────────────
# The staged-files scan above cannot see code that arrived without being staged
# by a human — a merge resolution, most of all. That is exactly how a @Data
# slipped back in unnoticed. A full scan of petclinic-backend/src takes ~40ms,
# so there is no reason to gate it on anything. Warnings are printed and only
# `error` rules block, so pre-existing warnings elsewhere stay non-blocking.
if command -v sg >/dev/null 2>&1 && sg scan --help >/dev/null 2>&1; then
  if ! SG_ALL=$(cd "$ROOT" && sg scan -c "$ROOT/.config/sgconfig.yml" petclinic-backend/src 2>&1); then
    echo "$SG_ALL"
    echo "[pre-commit] ❌ ast-grep rule violated somewhere in petclinic-backend/src — commit blocked."
    echo "[pre-commit]    (this pass is not limited to your staged files, on purpose)"
    exit 1
  fi
fi

# ── Lombok and MapStruct must not come back through the build either ───────
# The ast-grep rules read Java sources; nothing there notices a dependency
# reappearing in a POM ahead of the first annotation that uses it.
for pom in "$ROOT"/petclinic-*/pom.xml; do
  [ -f "$pom" ] || continue
  for artifact in projectlombok mapstruct; do
    if grep -q "$artifact" "$pom" 2>/dev/null; then
      echo "[pre-commit] ❌ $artifact is back in ${pom#$ROOT/} — commit blocked."
      echo "[pre-commit]    Both were removed on purpose so a clone builds with javac"
      echo "[pre-commit]    alone, no annotation processor in the way; see AGENTS.md."
      exit 1
    fi
  done
done

# ── .editorconfig compliance ───────────────────────────────────────────────
# Nothing else in this repo reads .editorconfig — no IDE is in the loop, and
# neither Spotless nor eslint enforces it. Without this it is documentation.
# Scoped to staged files; settings (and the disabled indent checks) in
# .config/editorconfig-checker.json.
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACMR || true)
# Symlinks are dropped: git stages the link, but the checker follows it and lints
# whatever it points at. `.claude/skills/human-review` points into another repository
# — 287 "violations" in files this repo does not own, .pyc files among them.
if [ -n "$STAGED_ALL" ]; then
  STAGED_ALL=$(echo "$STAGED_ALL" | while IFS= read -r f; do
    [ -L "$f" ] || printf '%s\n' "$f"
  done)
fi
if [ -n "$STAGED_ALL" ]; then
  if command -v editorconfig-checker >/dev/null 2>&1; then
    if ! EC_OUT=$(echo "$STAGED_ALL" | xargs editorconfig-checker -no-color -config "$ROOT/.config/editorconfig-checker.json" 2>&1); then
      echo "$EC_OUT"
      echo "[pre-commit] ❌ .editorconfig violated — commit blocked."
      exit 1
    fi
  else
    echo "[pre-commit] ⚠️  editorconfig-checker not installed — skipping .editorconfig check."
    echo "[pre-commit] Install with: brew install editorconfig-checker"
  fi
fi

# ── Frontend: regenerate TS types from openapi.yaml ────────────────────────
# Gated: only run when openapi.yaml is staged — that's the sole input.
if git diff --cached --name-only | grep -qx 'openapi.yaml'; then
  if command -v npm >/dev/null 2>&1 && [ -d "$ROOT/petclinic-frontend/node_modules" ]; then
    NPM_OUT=$(mktemp)
    trap 'rm -f "$NPM_OUT"' EXIT
    if ! npm --prefix "$ROOT/petclinic-frontend" run generate:api --silent >"$NPM_OUT" 2>&1; then
      cat "$NPM_OUT"
      echo "[pre-commit] ❌ TS-types regeneration failed — commit blocked."
      exit 1
    fi
    git add "$ROOT/petclinic-frontend/src/app/generated/api-types.ts"
  else
    echo "[pre-commit] ⚠️  npm or petclinic-frontend/node_modules missing — skipping TS-types regen."
    echo "[pre-commit]    Install with: cd petclinic-frontend && npm install"
  fi
fi

# ── DB schema → ER diagram (plain snapshot) ────────────────────────────────
# Gated: only run when petclinic-backend/docs/generated/DB.sql is staged — that's the sole input. Regenerates
# docs/generated/DB.puml as a plain snapshot of the current schema and stages it
# so the diagram is committed alongside the schema change.
if git diff --cached --name-only | grep -qx 'petclinic-backend/docs/generated/DB.sql'; then
  if command -v python3 >/dev/null 2>&1; then
    DBDIAG_OUT=$(mktemp)
    trap 'rm -f "$NPM_OUT" "$DBDIAG_OUT"' EXIT
    if ! "$ROOT/petclinic-backend/docs/scripts/db/gen-db-schema-diagram.sh" >"$DBDIAG_OUT" 2>&1; then
      cat "$DBDIAG_OUT"
      echo "[pre-commit] ❌ DB schema diagram generation failed — commit blocked."
      exit 1
    fi
    git add "$ROOT/petclinic-backend/docs/generated/DB.puml"
  else
    echo "[pre-commit] ⚠️  python3 missing — skipping DB schema diagram regen."
    echo "[pre-commit]    Install Python 3 to keep DB.puml in sync."
  fi
fi

# ── Unversioned-dependency surface (deps declared with no <version>) ────────
# Gated: only when a pom.xml is staged — that's the sole input. Regenerates
# petclinic-backend/pom-libs.txt and stages it so the managed-version surface is
# reviewed (via CODEOWNERS) alongside the dependency change.
if git diff --cached --name-only | grep -qE '(^|/)pom\.xml$'; then
  if command -v python3 >/dev/null 2>&1; then
    if ! DEPS_OUT=$(python3 "$ROOT/scripts/list-unversioned-deps.py" 2>&1); then
      echo "$DEPS_OUT"
      echo "[pre-commit] ❌ unversioned-deps list generation failed — commit blocked."
      exit 1
    fi
    git add "$ROOT/petclinic-backend/pom-libs.txt"
  else
    echo "[pre-commit] ⚠️  python3 missing — skipping unversioned-deps list regen."
  fi
fi

echo "✅ pre-commit"
