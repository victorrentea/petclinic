# Multi-arch JMeter. Built here rather than pulled because the published jmeter images
# are amd64-only: under QEMU on an arm64 host the load generator saturates before the
# server does, and every latency number becomes a measurement of the emulator.
FROM eclipse-temurin:21-jre

ARG JMETER_VERSION=5.6.3

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/jmeter.tgz \
      "https://archive.apache.org/dist/jmeter/binaries/apache-jmeter-${JMETER_VERSION}.tgz" \
    && tar -xzf /tmp/jmeter.tgz -C /opt \
    && rm /tmp/jmeter.tgz \
    && ln -s "/opt/apache-jmeter-${JMETER_VERSION}" /opt/jmeter

ENV PATH="/opt/jmeter/bin:${PATH}" \
    JVM_ARGS="-Xms1g -Xmx2g"

WORKDIR /work
ENTRYPOINT ["jmeter"]
