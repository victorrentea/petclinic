# Any PR touching these paths must be approved by a 2nd (senior) human
# Works everywhere: in GitHub, GitLab, BitBucket ...
#
# Two layers of defenders:
# - @victorrentea/tech-leads: ordinary design-surface changes (API, DB, domain model, architecture)
# - @victorrentea/elders: only when the guardrail system itself is touched (its tests, the CI/hooks
#   that run them, agent settings, this file, or the dependency surface those guardrails police)

# API Contracts
/openapi.yaml                    @victorrentea/tech-leads

# Persistence
/petclinic-backend/docs/generated/DB.sql @victorrentea/tech-leads
/petclinic-backend/src/main/resources/db/migration/ @victorrentea/tech-leads

# Domain Model
/petclinic-backend/docs/generated/DomainModel.puml @victorrentea/tech-leads

# Logical Architecture
/petclinic-backend/docs/packages.puml @victorrentea/tech-leads
/petclinic-backend/docs/c4model.c1+c2.dsl    @victorrentea/tech-leads
/petclinic-backend/docs/c4model.c3.dsl @victorrentea/tech-leads

# GIT + Agent Settings (the guardrail system itself)
/.github/CODEOWNERS              @victorrentea/elders
/.claude/settings.json           @victorrentea/elders
/.github/workflows/*             @victorrentea/elders
/.github/githooks/*             @victorrentea/elders
/petclinic-backend/src/test/java/victor/training/petclinic/guardrail/** @victorrentea/elders

# Dependencies / SBOM (the surface the guardrail dep-drift check polices)
**/pom.xml      @victorrentea/elders
**/package.json @victorrentea/elders
# Generated surface of deps declared with no <version> (inherited from a parent/BOM)
/petclinic-backend/pom-libs.txt @victorrentea/elders

